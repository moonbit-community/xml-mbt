  // xmltest/valid/sa/061.xml
  w3c_accept(
    "<!DOCTYPE doc [\r\n<!ELEMENT doc (#PCDATA)>\r\n]>\r\n<doc>&#163;</doc>\r\n",
    namespaces=true,
    expected="<doc>\u{a3}</doc>",
  )
}

