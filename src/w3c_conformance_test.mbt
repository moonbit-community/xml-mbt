}

///|
test "w3c/not-wf/sgml11" {
  // sun/not-wf/sgml11.xml
  w3c_reject(
    "<!DOCTYPE root [\n    <!-- SGML-ism:  CDATA content type -->\n    <!ELEMENT ROOT CDATA>\n]>\n\n<root/>\n\n",
