  w3c_accept(
    "<!DOCTYPE doc [\r\n<!ELEMENT doc (#PCDATA)>\r\n]>\r\n<doc>&#xe40;&#xe08;&#xe21;\u{e2a}\u{e4c}</doc>\r\n",
    namespaces=true,
    expected="<doc>\u{e40}\u{e08}\u{e21}\u{e2a}\u{e4c}</doc>",
  )
}

///|
test "w3c/valid/valid-sa-063" {
