///|
test "w3c/valid/ibm-valid-P01-ibm01v01.xml" {
  // ibm/valid/P01/ibm01v01.xml
  w3c_accept(
    "<?xml version=\"1.0\" encoding=\"utf-8\" standalone=\"yes\" ?>\r\n<!-- Above is XMLDecl -->\r\n<!DOCTYPE animal [\r\n<!ELEMENT animal (cat|tiger|leopard)+>\r\n<!ELEMENT cat EMPTY>\r\n<!ELEMENT tiger (#PCDATA)>\r\n<!ELEMENT leopard ANY>\r\n<!ELEMENT small EMPTY>\r\n<!ELEMENT big EMPTY>\r\n<!ATTLIST tiger color CDATA #REQUIRED>\r\n]>\r\n<!-- Above is DTD -->\r\n<?music \"Here is a PI\" ?> \r\n<animal>\r\n   <cat/>\r\n   <tiger color=\"white\">This is a white tiger in Mirage!!</tiger>\r\n   <cat/>\r\n   <leopard>\r\n      <small/>\r\n      <big/>\r\n   </leopard>\r\n</animal>\r\n<!-- Above is element animal -->\r\n\r\n",
    namespaces=true,
    expected="<?music \"Here is a PI\" ?><animal>&#10;   <cat></cat>&#10;   <tiger color=\"white\">This is a white tiger in Mirage!!</tiger>&#10;   <cat></cat>&#10;   <leopard>&#10;      <small></small>&#10;      <big></big>&#10;   </leopard>&#10;</animal>",
  )
}

///|
test "w3c/valid/ibm-valid-P02-ibm02v01.xml" {
  // ibm/valid/P02/ibm02v01.xml
  w3c_accept(
    "<?xml version=\"1.0\" encoding=\"UTF-8\" ?>\r\n<!DOCTYPE book [\r\n<!ELEMENT book ANY>\r\n<!-- This test case covers     legal character ranges plus\r\n        discrete legal characters for production 02. -->\r\n<?NAME_09-\t_0A-\r\n_0D-\r\n_20- _D7FF-\u{d7ff}_6c0f-\u{6c0f}_E000-\u{e000}_FFFD-\u{fffd}_effe-\u{effe}_010000-\u{10000}_10FFFF-\u{10ffff}_08ffff-\u{8ffff} This is a PI target ?>\r\n]>\r\n<book/>\r\n",
    namespaces=true,
  )
}

///|
test "w3c/valid/ibm-valid-P03-ibm03v01.xml" {
  // ibm/valid/P03/ibm03v01.xml
  w3c_accept(
    "<?xml version=\"1.0\" encoding=\"UTF-8\" ?>\r\r\n<!DOCTYPE book [\r\r\n<!ELEMENT book ANY>\r\r\n<!-- This test case covers 0 legal character ranges plus\r\r\n     4 discrete legal characters for production 03. -->\r\r\n<?NAME_20- _09-\t_0D-\r_0A-\r\r\n This is a PI target ?>\r\r\n]>\r\r\n<book/>\r\r\n",
    namespaces=true,
  )
}

///|
test "w3c/valid/ibm-valid-P09-ibm09v01.xml" {
  // ibm/valid/P09/ibm09v01.xml
  w3c_accept(
    "<?xml version=\"1.0\"?>\r\n<!DOCTYPE student [\r\n\t<!ELEMENT student (#PCDATA)> \r\n \t<!ENTITY FullName \"\">\r\n]>\r\n\r\n<student>My Name is &FullName;. </student>\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n ",
    namespaces=true,
    expected="<student>My Name is . </student>",
  )
}

///|
test "w3c/valid/ibm-valid-P09-ibm09v02.xml" {
  // ibm/valid/P09/ibm09v02.xml
  w3c_accept(
