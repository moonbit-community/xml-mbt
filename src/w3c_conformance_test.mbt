  )
}

///|
test "w3c/not-wf/sgml12" {
  // sun/not-wf/sgml12.xml
  w3c_reject(
    "<!DOCTYPE root [\n    <!-- SGML-ism:  RCDATA content type -->\n    <!ELEMENT ROOT RCDATA>\n]>\n\n<root/>\n\n\n",
